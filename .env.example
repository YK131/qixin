# 留空则不调用 AI，本地四维规则与周报仍可完整工作。
QIXIN_AI_API_KEY=
QIXIN_AI_BASE_URL=https://api.openai.com/v1
QIXIN_AI_MODEL=gpt-4.1-mini

# 南京（仙林校区附近）默认坐标；可通过环境变量覆盖。
QIXIN_CITY=南京
QIXIN_LAT=32.0603
QIXIN_LON=118.7969

# 可选：为某段音景接入你有权使用的第三方播放页。
# 未设置时播放本地生成的环境声。
QIXIN_MUSIC_RAIN_WINDOW_URL=
QIXIN_MUSIC_DEEP_FOREST_URL=
